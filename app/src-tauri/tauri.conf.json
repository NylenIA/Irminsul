{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irminsul",
  "version": "0.1.0",
  "identifier": "com.nylenia.irminsul",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Irminsul",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "externalBin": ["binaries/irminsul-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "copyright": "© NylenIA",
    "category": "Utility",
    "shortDescription": "Assistant Genshin Impact",
    "longDescription": "Compte, équipes, calculs et simulations Genshin Impact, en local."
  }
}
